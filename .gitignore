# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# netlify (build cache/output, régénéré à chaque déploiement)
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# notes de travail locales (assistants IA, prompts de design)
CLAUDE.md
AGENTS.md
V0_PROMPTS.md
